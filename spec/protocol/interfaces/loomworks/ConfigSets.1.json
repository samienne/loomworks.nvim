{
  "interface": "loomworks.ConfigSets",
  "version": 1,
  "status": "draft",
  "description": "Object /projects (API.md §20, step 5o part B2): the configuration sets (spec §1.4). candidates is a query; the others are commands, each in a model segment of the caller's environment, its write the in-process editor's (loomworks.model_commands); Workspace/1 changed precedes the reply. A refused or failed write changes neither the file nor the model: the refused result.",
  "methods": {
    "candidates": {
      "description": "The declared configuration sets (config_set their id) and the automatic ones the projects allow (auto), each automatic one with candidate, an opaque token Profiles/1.create and tool_choices accept in place of a reference. Changes nothing.",
      "params": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Candidates"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": false
    },
    "add": {
      "description": "Declare a configuration set. A project or configuration of mappings that does not exist, or a name already taken, is refused.",
      "params": {
        "type": "object",
        "required": [
          "name",
          "mappings"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "mappings": {
            "description": "Project key → configuration name; a project absent is unmapped.",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/OkConfigSet"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "update": {
      "description": "Replace the set's mappings; a name other than its key renames it, propagated to profiles and the cache (spec §4.10) under the workspace operation lock. A rename that succeeded before a mapping failed is ok with a warn note (API.md §4.1).",
      "params": {
        "type": "object",
        "required": [
          "config_set",
          "mappings"
        ],
        "additionalProperties": false,
        "properties": {
          "config_set": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "name": {
            "type": "string"
          },
          "mappings": {
            "description": "Project key → configuration name; a project absent is unmapped.",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Ok"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "remove": {
      "description": "Remove the declaration; its profiles stay, shown with a missing set (spec §4.4).",
      "params": {
        "type": "object",
        "required": [
          "config_set"
        ],
        "additionalProperties": false,
        "properties": {
          "config_set": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Ok"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "generate_defaults": {
      "description": "Add the sets the projects' configurations suggest that do not exist yet; the notes name the sets added.",
      "params": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Ok"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    }
  },
  "$defs": {
    "Ok": {
      "description": "A command applied (API.md §4.1).",
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "notes": {
          "$ref": "loomworks.Common/1#/$defs/Notes"
        },
        "note_roles": {
          "$ref": "loomworks.Common/1#/$defs/NoteRoles"
        }
      }
    },
    "OkConfigSet": {
      "description": "The configuration set added (its key is its name).",
      "type": "object",
      "required": [
        "outcome",
        "config_set"
      ],
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "config_set": {
          "$ref": "loomworks.Common/1#/$defs/Entity"
        },
        "notes": {
          "$ref": "loomworks.Common/1#/$defs/Notes"
        },
        "note_roles": {
          "$ref": "loomworks.Common/1#/$defs/NoteRoles"
        }
      }
    },
    "Candidates": {
      "description": "The declared and the automatic configuration sets.",
      "type": "object",
      "required": [
        "outcome",
        "sets"
      ],
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "sets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "auto"
            ],
            "additionalProperties": false,
            "properties": {
              "config_set": {
                "$ref": "loomworks.Common/1#/$defs/Id"
              },
              "name": {
                "type": "string"
              },
              "auto": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "candidate": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
