{
  "interface": "loomworks.Projects",
  "version": 1,
  "status": "draft",
  "description": "Object /projects (API.md §19, step 5o part B3): a workspace's projects and what they declare. candidates, declaration and expand_preview are queries; the others are commands, each in a model segment of the caller's environment, its write the in-process editor's (loomworks.model_commands). A project is named by a Ref; a configuration by a Ref (its id, or its key with the project); a launch configuration by a Ref (API.md §1.2: its id, refused when it is another project's, or its name with the project); a variable, the deploy declaration or a type_config field by the project and its name. A stale id is refused (a stale reference) and changes nothing. A project is removed with Maintenance/1.execute_deletion.",
  "methods": {
    "candidates": {
      "description": "What adding the directory path (relative to the workspace root, or absolute under it) as a project would declare, detected in the client's environment: the derived key and path, the module types that detect it (types, each with its marker), the configurations the module (type, else the first detected) offers, a proposed mapping into each configuration set (set name → configuration name), the keyed toolchains (only the one the profiles already use, inherited, when there is one) and the profiles each toolchain would upgrade. A path outside the root (exit 2), a missing directory or an unknown type (exit 2) is refused. Changes nothing.",
      "params": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Candidates"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": false
    },
    "add": {
      "description": "Declare the project (API.md §19), map it into each configuration set by mappings (set name → configuration name) and, with tool (a toolchain key from candidates), upgrade the affected profiles to it under the workspace operation lock. A keyed module's project without a tool is added unmapped. An upgrade that fails after the project was added is ok with a warn note (§4.1). An existing key, an invalid key, an unknown type (exit 2) or an unknown toolchain is refused.",
      "params": {
        "type": "object",
        "required": [
          "key",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "mappings": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tool": {
            "type": "object",
            "required": [
              "key"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              }
            }
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/OkProject"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "declaration": {
      "description": "The project's declaration as the working copy holds it (merged as spec §2.4 merges it), for a client's editors (API.md §19).",
      "params": {
        "type": "object",
        "required": [
          "project"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Declaration"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": false
    },
    "configuration_save": {
      "description": "Create a user configuration (no configuration) or update one: fields replace the dialog's fields (inherits, options, variables, languages, toolchain, generator; an absent field is cleared), every other declared field kept. A name other than its key renames it, propagated to configuration sets, profiles and the cache (spec §4.8) under the workspace operation lock (a held lock is refused, naming its holder); the id is kept.",
      "params": {
        "type": "object",
        "required": [
          "project",
          "name",
          "fields"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "configuration": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "name": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "inherits": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "variables": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "toolchain": {
                "type": "string"
              },
              "generator": {
                "type": "string"
              }
            }
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/OkConfiguration"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "configuration_remove": {
      "description": "Remove the configuration's declaration; its build state stays, as an orphaned configuration (spec §4.5).",
      "params": {
        "type": "object",
        "required": [
          "project",
          "configuration"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "configuration": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Ok"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "options_save": {
      "description": "The project's options (option name → value); an empty object removes them.",
      "params": {
        "type": "object",
        "required": [
          "project",
          "options"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Ok"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "launch_save": {
      "description": "Create a launch configuration (no launch) or replace the editor's fields of one (command, args, working_dir, env, deploy, debug; an absent or empty one is removed, a command replaces a target; other declared fields such as device are kept). A name other than its key renames it as spec §8.7 does (profiles' default targets, units' target entries and saved test entries follow), its id kept; the rename writes only the working copy and takes no workspace operation lock. A renamed launch whose fields were then not saved is ok with a warn note.",
      "params": {
        "type": "object",
        "required": [
          "project",
          "name",
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "launch": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "name": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "working_dir": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "deploy": {
                "description": "The deploy declaration (spec §8.8): destination template → a source descriptor or an array of them.",
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  ]
                }
              },
              "debug": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/OkLaunch"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "launch_remove": {
      "description": "Remove the launch configuration's declaration.",
      "params": {
        "type": "object",
        "required": [
          "project",
          "launch"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "launch": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Ok"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "deploy_save": {
      "description": "The project's whole deploy declaration; no deploy (or an empty one) removes it.",
      "params": {
        "type": "object",
        "required": [
          "project"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "deploy": {
            "description": "The deploy declaration (spec §8.8): destination template → a source descriptor or an array of them.",
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              ]
            }
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Ok"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "variable_save": {
      "description": "Declare a variable (no variable) or replace one, variable its current name (a rename when name differs). A variable the project does not declare is refused.",
      "params": {
        "type": "object",
        "required": [
          "project",
          "name",
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "variable": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "path"
                ]
              },
              "default": {
                "type": "string"
              }
            }
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Ok"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "variable_remove": {
      "description": "Remove the variable's declaration. A variable the project does not declare is refused.",
      "params": {
        "type": "object",
        "required": [
          "project",
          "variable"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "variable": {
            "type": "string"
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Ok"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "type_config_set": {
      "description": "One of the module's editable type_config fields (API.md §14.4 type_config); no value clears it. A field that is not one of them is refused (exit 2).",
      "params": {
        "type": "object",
        "required": [
          "project",
          "field"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "field": {
            "type": "string"
          },
          "value": {}
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Ok"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "expand_preview": {
      "description": "Each template expanded as a launch of the project would expand it (spec §1.3.1, §8.7), under profile or the active profile, in the client's environment; an unresolved reference stays as written. No profile and no active one is refused.",
      "params": {
        "type": "object",
        "required": [
          "project",
          "templates"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "profile": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "templates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Values"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": false
    }
  },
  "$defs": {
    "Ok": {
      "description": "A command applied (API.md §4.1).",
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "notes": {
          "$ref": "loomworks.Common/1#/$defs/Notes"
        },
        "note_roles": {
          "$ref": "loomworks.Common/1#/$defs/NoteRoles"
        }
      }
    },
    "OkProject": {
      "description": "The project added.",
      "type": "object",
      "required": [
        "outcome",
        "project"
      ],
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "project": {
          "$ref": "loomworks.Common/1#/$defs/Entity"
        },
        "notes": {
          "$ref": "loomworks.Common/1#/$defs/Notes"
        },
        "note_roles": {
          "$ref": "loomworks.Common/1#/$defs/NoteRoles"
        }
      }
    },
    "OkConfiguration": {
      "description": "The configuration created or updated (its key the name it now has).",
      "type": "object",
      "required": [
        "outcome",
        "configuration"
      ],
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "configuration": {
          "$ref": "loomworks.Common/1#/$defs/Entity"
        },
        "notes": {
          "$ref": "loomworks.Common/1#/$defs/Notes"
        },
        "note_roles": {
          "$ref": "loomworks.Common/1#/$defs/NoteRoles"
        }
      }
    },
    "OkLaunch": {
      "description": "The launch configuration created or updated (its key the name it now has).",
      "type": "object",
      "required": [
        "outcome",
        "launch"
      ],
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "launch": {
          "$ref": "loomworks.Common/1#/$defs/Entity"
        },
        "notes": {
          "$ref": "loomworks.Common/1#/$defs/Notes"
        },
        "note_roles": {
          "$ref": "loomworks.Common/1#/$defs/NoteRoles"
        }
      }
    },
    "Candidates": {
      "type": "object",
      "required": [
        "outcome",
        "key",
        "path",
        "types",
        "mappings",
        "configurations"
      ],
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "key": {
          "description": "The derived project key.",
          "type": "string"
        },
        "path": {
          "description": "The project's path relative to the root.",
          "type": "string"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "marker": {
                "type": "string"
              }
            }
          }
        },
        "mappings": {
          "description": "Configuration set name → the proposed configuration name.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "configurations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "description": "A keyed module's toolchains (absent for a module without keyed toolchains); only the one the profiles already use, inherited, when there is one.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "inherited": {
                "type": "boolean"
              }
            }
          }
        },
        "upgrade_preview": {
          "description": "The profiles a toolchain choice would upgrade: one entry per (toolchain, profile), from its key to the key it gets.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tool",
              "from",
              "to"
            ],
            "properties": {
              "tool": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "$ref": "loomworks.Common/1#/$defs/Notes"
        },
        "note_roles": {
          "$ref": "loomworks.Common/1#/$defs/NoteRoles"
        }
      }
    },
    "Declaration": {
      "type": "object",
      "required": [
        "outcome",
        "configurations",
        "launches",
        "variables",
        "options",
        "type_config"
      ],
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "configurations": {
          "description": "Ordered by name; fields the configuration's declared data (module fields flat, generic fields by their data names); user when it is a user configuration.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "key",
              "fields"
            ],
            "properties": {
              "id": {
                "$ref": "loomworks.Common/1#/$defs/Id"
              },
              "key": {
                "type": "string"
              },
              "user": {
                "type": "boolean"
              },
              "fields": {
                "type": "object"
              }
            }
          }
        },
        "launches": {
          "description": "Ordered by name; fields the declared table (absent and invalid true when the declaration is not a table).",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "key"
            ],
            "properties": {
              "id": {
                "$ref": "loomworks.Common/1#/$defs/Id"
              },
              "key": {
                "type": "string"
              },
              "fields": {
                "type": "object"
              },
              "invalid": {
                "type": "boolean"
              }
            }
          }
        },
        "deploy": {
          "description": "The deploy declaration (spec §8.8): destination template → a source descriptor or an array of them.",
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            ]
          }
        },
        "variables": {
          "description": "Variable name → its declaration.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "default": {
                "type": "string"
              }
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "type_config": {
          "type": "object",
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "description": "The module's editable type_config fields in the module's order, as view.Workspace/1 gives them.",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "placeholder": {
                    "type": "string"
                  },
                  "value": {}
                }
              }
            }
          }
        },
        "notes": {
          "$ref": "loomworks.Common/1#/$defs/Notes"
        },
        "note_roles": {
          "$ref": "loomworks.Common/1#/$defs/NoteRoles"
        }
      }
    },
    "Values": {
      "type": "object",
      "required": [
        "outcome",
        "values"
      ],
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "values": {
          "type": "array",
