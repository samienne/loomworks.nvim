{
  "interface": "loomworks.Profiles",
  "version": 1,
  "status": "draft",
  "description": "Object /profiles (API.md §11): queries of a profile and the choice of its device. Step 5g.2 lands compiler_cache (the protocol-10 query profile_cache stays as its v0 alias); step 5n (part B2) set_device and clear_device; list and the other command methods follow in step 5o.",
  "methods": {
    "compiler_cache": {
      "description": "The compiler cache the profile resolves for one of its projects, as lw profile query <profile> <project> cache prints it; cache is absent when the project's module does not cache C/C++. Probes the client's PATH. An unknown profile, a project the profile does not map, or a stale id is the refused result.",
      "params": {
        "type": "object",
        "required": [
          "profile",
          "project"
        ],
        "additionalProperties": false,
        "properties": {
          "profile": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "project": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/CompilerCacheResult"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": false
    },
    "set_device": {
      "description": "Set the profile's device to one of Devices/1.list's devices (API.md §11, §15), persisted as the profile's device (its serial) in the working copy (user.json, never loomworks.json), as the in-process Profile:set_device writes it, in a model segment of the caller's environment; the write's model_change (Workspace/1 changed) precedes the reply, and Devices/1 changed and the views' update follow. An unknown or stale profile or device, or a refused or failed write (a stale or untrusted working copy, a refused load), changes neither the file nor the model: the refused result.",
      "params": {
        "type": "object",
        "required": [
          "profile",
          "device"
        ],
        "additionalProperties": false,
        "properties": {
          "profile": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          },
          "device": {
            "description": "The device: its id, or its key (the serial).",
            "$ref": "loomworks.Common/1#/$defs/Ref"
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Ok"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    },
    "clear_device": {
      "description": "Remove the profile's device from the working copy, as set_device writes it (the same segment, signals and refusals).",
      "params": {
        "type": "object",
        "required": [
          "profile"
        ],
        "additionalProperties": false,
        "properties": {
          "profile": {
            "$ref": "loomworks.Common/1#/$defs/Ref"
          }
        }
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/Ok"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Refused"
          },
          {
            "$ref": "loomworks.Common/1#/$defs/Declined"
          }
        ]
      },
      "needs_env": true,
      "mutates": true
    }
  },
  "$defs": {
    "CompilerCacheResult": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "cache": {
          "type": "object",
          "required": [
            "policy",
            "present",
            "stale",
            "msvc_auto_off",
            "applicable"
          ],
          "properties": {
            "policy": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "present": {
              "type": "boolean"
            },
            "stale": {
              "type": "boolean"
            },
            "msvc_auto_off": {
              "type": "boolean"
            },
            "applicable": {
              "type": "boolean"
            },
            "not_applied_reason": {
              "type": "string"
            },
            "not_applied_hint": {
              "type": "string"
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note_roles": {
          "$ref": "loomworks.Common/1#/$defs/NoteRoles"
        }
      }
    },
    "Ok": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note_roles": {
          "$ref": "loomworks.Common/1#/$defs/NoteRoles"
        }
      }
    }
  }
}
