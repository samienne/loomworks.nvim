{
  "transcripts": 1,
  "interface": "loomworks.view.Tests",
  "version": 1,
  "description": "Object /views (spec 19.13 The tests view, 19.20): get, and the update signal with the full state as initial; stale until a discovery of the active profile ran, again after a build of its unit; the tree with explicit suite nodes and node ids stable across re-discoveries.",
  "cases": [
    {
      "name": "get reports an unloaded view without loading it; unknown arguments are invalid",
      "fixture": "tests",
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/views", "iface": "loomworks.view.Tests", "v": 1, "method": "get", "args": {} } },
        { "expect": { "kind": "ok", "req_id": 1, "result": { "$exact": { "state": "unloaded", "stale": false, "units": [] } } } },
        { "send": { "kind": "call", "req_id": 2, "object": "/views", "iface": "loomworks.view.Tests", "v": 1, "method": "get", "args": { "x": 1 } } },
        { "expect": { "kind": "error", "req_id": 2, "error": { "code": "invalid_args" } } }
      ]
    },
    {
      "name": "subscribing returns the full state as initial; discoveries and a build send update with the full state",
      "fixture": "tests",
      "allow": [
        { "kind": "task" },
        { "kind": "model_change" }
      ],
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/", "iface": "loomworks.Root", "v": 1, "method": "subscribe", "args": { "object": "/views", "iface": "loomworks.view.Tests", "v": 1 } } },
        { "expect": { "kind": "ok", "req_id": 1, "result": {
            "sub_id": { "$bind": "sub" }, "seq": 0,
            "initial": { "$exact": { "state": "unloaded", "stale": false, "units": [] } }
        } } },

        { "send": { "kind": "call", "req_id": 2, "object": "/tests", "iface": "loomworks.Tests", "v": 1, "method": "discover", "args": {}, "env": { "$var": "env" } } },
        { "expect": {
            "kind": "signal", "object": "/views", "iface": "loomworks.view.Tests", "v": 1, "name": "update", "sub_id": { "$var": "sub" }, "seq": 1,
            "args": { "state": "loaded", "profile": "dev", "profile_id": { "$bind": "profile" }, "stale": true, "discovering": { "$absent": true },
              "units": [ { "project": "app", "configuration": "Debug", "id": { "$bind": "unit" }, "state": "not_configured", "message": { "$type": "string" }, "nodes": [] } ] }
        } },
        { "expect": { "kind": "ok", "req_id": 2, "result": { "outcome": "accepted", "task_id": { "$bind": "d1" }, "profile_key": "dev" } } },
        { "expect": {
            "kind": "signal", "object": "/views", "name": "update", "sub_id": { "$var": "sub" }, "seq": 2,
            "args": { "state": "loaded", "profile": "dev", "stale": false, "discovering": { "$absent": true },
              "units": [ { "project": "app", "id": { "$var": "unit" }, "state": "not_configured", "nodes": [] } ] }
        } },
        { "expect": { "kind": "task", "task_id": { "$var": "d1" }, "phase": "done", "exit_code": 0, "result": { "exit_code": 0, "tests": 0, "failed": 0 } } },

        { "send": { "kind": "call", "req_id": 3, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "profile": { "key": "dev" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 3, "result": { "outcome": "accepted", "task_id": { "$bind": "b" } } } },
        { "expect": {
            "kind": "signal", "object": "/views", "name": "update", "sub_id": { "$var": "sub" }, "seq": 3,
            "args": { "state": "loaded", "stale": true,
              "units": [ { "project": "app", "id": { "$var": "unit" }, "state": "pending", "nodes": [] } ] }
        } },
        { "expect": { "kind": "task", "task_id": { "$var": "b" }, "phase": "done", "exit_code": 0 }, "timeout_ms": 120000 },

        { "send": { "kind": "call", "req_id": 4, "object": "/tests", "iface": "loomworks.Tests", "v": 1, "method": "discover", "args": {}, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 4, "result": { "outcome": "accepted", "task_id": { "$bind": "d2" } } } },
        { "expect": {
            "kind": "signal", "object": "/views", "name": "update", "sub_id": { "$var": "sub" }, "seq": 4,
            "args": { "stale": true, "discovering": { "$var": "d2" },
              "units": [ { "project": "app", "state": "pending", "nodes": [] } ] }
        } },
        { "expect": {
            "kind": "signal", "object": "/views", "name": "update", "sub_id": { "$var": "sub" }, "seq": 5,
            "args": { "state": "loaded", "profile": "dev", "profile_id": { "$var": "profile" }, "stale": false, "discovering": { "$absent": true },
              "units": [ { "project": "app", "configuration": "Debug", "id": { "$var": "unit" }, "state": "ok", "message": { "$absent": true },
                "nodes": [
                  { "$exact": { "id": { "$bind": "unit_a" }, "kind": "target", "name": "unit_a", "runnable": true, "source": "teststub" } },
                  { "$exact": { "id": { "$bind": "math" }, "kind": "suite", "name": "Math", "parent": { "$var": "unit_a" }, "runnable": true, "source": "gtest" } },
                  { "$exact": { "id": { "$bind": "add" }, "kind": "test", "name": "Add", "parent": { "$var": "math" }, "runnable": true, "source": "gtest",
                    "file": { "$pattern": "/app/math_test[.]cc$" }, "line": 3 } },
                  { "id": { "$bind": "sub_case" }, "kind": "test", "name": "Sub", "parent": { "$var": "math" }, "status": { "$absent": true } },
                  { "id": { "$bind": "unit_b" }, "kind": "target", "name": "unit_b", "parent": { "$absent": true } },
                  { "id": { "$bind": "str" }, "kind": "suite", "name": "Str", "parent": { "$var": "unit_b" } },
                  { "id": { "$bind": "upper" }, "kind": "test", "name": "Upper", "parent": { "$var": "str" }, "file": { "$absent": true } }
                ] } ] }
        } },
        { "expect": { "kind": "task", "task_id": { "$var": "d2" }, "phase": "done", "exit_code": 0, "result": { "exit_code": 0, "tests": 3, "failed": 0 } }, "timeout_ms": 60000 },

        { "send": { "kind": "call", "req_id": 5, "object": "/tests", "iface": "loomworks.Tests", "v": 1, "method": "discover", "args": {}, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 5, "result": { "outcome": "accepted", "task_id": { "$bind": "d3" } } } },
        { "expect": { "kind": "task", "task_id": { "$var": "d3" }, "phase": "done", "exit_code": 0, "result": { "exit_code": 0, "tests": 3, "failed": 0 } } },
        { "expect_none": { "kind": "signal", "object": "/views", "name": "update" }, "within_ms": 200 },

        { "send": { "kind": "call", "req_id": 6, "object": "/tests", "iface": "loomworks.Tests", "v": 1, "method": "discover", "args": { "force": true }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 6, "result": { "outcome": "accepted", "task_id": { "$bind": "d4" } } } },
        { "expect": {
            "kind": "signal", "object": "/views", "name": "update", "sub_id": { "$var": "sub" }, "seq": 6,
            "args": { "stale": false, "discovering": { "$var": "d4" }, "units": [ { "state": "ok", "nodes": { "$len": 7 } } ] }
        } },
        { "expect": {
            "kind": "signal", "object": "/views", "name": "update", "sub_id": { "$var": "sub" }, "seq": 7,
            "args": { "stale": false, "discovering": { "$absent": true },
              "units": [ { "state": "ok", "nodes": [
                { "id": { "$var": "unit_a" } }, { "id": { "$var": "math" } }, { "id": { "$var": "add" } }, { "id": { "$var": "sub_case" } },
                { "id": { "$var": "unit_b" } }, { "id": { "$var": "str" } }, { "id": { "$var": "upper" } }
              ] } ] }
        } },
        { "expect": { "kind": "task", "task_id": { "$var": "d4" }, "phase": "done", "exit_code": 0 }, "timeout_ms": 60000 },

        { "send": { "kind": "call", "req_id": 7, "object": "/views", "iface": "loomworks.view.Tests", "v": 1, "method": "get", "args": {} } },
        { "expect": { "kind": "ok", "req_id": 7, "result": { "stale": false, "profile_id": { "$var": "profile" },
            "units": [ { "id": { "$var": "unit" }, "state": "ok", "nodes": { "$len": 7 } } ] } } }
      ]
    }
  ]
}
