{
  "transcripts": 1,
  "interface": "loomworks.ConfigSets",
  "version": 1,
  "description": "Object /projects, interface loomworks.ConfigSets (API.md §20; step 5o part B2): candidates with ids, add returning the set's id, an update that renames it under the same id, remove, generate_defaults, and the refusals of references and mappings.",
  "cases": [
    {
      "name": "candidates names the declared set by id; add → update (rename, id kept) → remove",
      "fixture": "shell",
      "allow": [ { "kind": "model_change" }, { "kind": "signal" } ],
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/projects", "iface": "loomworks.ConfigSets", "v": 1, "method": "candidates", "args": {}, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 1, "result": { "outcome": "ok", "sets": { "$contains": [ { "config_set": { "$type": "string" }, "name": "dev", "auto": false } ] } } } },
        { "send": { "kind": "call", "req_id": 2, "object": "/projects", "iface": "loomworks.ConfigSets", "v": 1, "method": "add", "args": { "name": "rel", "mappings": { "app": "Debug" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 2, "result": { "outcome": "ok", "config_set": { "id": { "$bind": "rel_id" }, "key": "rel" } } } },
        { "send": { "kind": "call", "req_id": 3, "object": "/projects", "iface": "loomworks.ConfigSets", "v": 1, "method": "update", "args": { "config_set": { "id": { "$var": "rel_id" } }, "name": "rel2", "mappings": { "app": "Debug" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 3, "result": { "outcome": "ok" } } },
        { "send": { "kind": "call", "req_id": 4, "object": "/projects", "iface": "loomworks.ConfigSets", "v": 1, "method": "candidates", "args": {}, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 4, "result": { "outcome": "ok", "sets": { "$contains": [ { "config_set": { "$var": "rel_id" }, "name": "rel2", "auto": false } ] } } } },
        { "send": { "kind": "call", "req_id": 5, "object": "/projects", "iface": "loomworks.ConfigSets", "v": 1, "method": "remove", "args": { "config_set": { "key": "rel2" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 5, "result": { "outcome": "ok" } } },
        { "send": { "kind": "call", "req_id": 6, "object": "/projects", "iface": "loomworks.ConfigSets", "v": 1, "method": "generate_defaults", "args": {}, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 6, "result": { "outcome": "ok" } } }
      ]
    },
    {
      "name": "a stale id, an unknown set, project or configuration is refused; a missing argument is invalid",
      "fixture": "shell",
      "allow": [ { "kind": "model_change" }, { "kind": "signal" } ],
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/projects", "iface": "loomworks.ConfigSets", "v": 1, "method": "remove", "args": { "config_set": { "id": "no-such-id" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 1, "result": { "outcome": "refused", "message": { "$pattern": "stale reference" }, "exit_code": 1 } } },
        { "send": { "kind": "call", "req_id": 2, "object": "/projects", "iface": "loomworks.ConfigSets", "v": 1, "method": "update", "args": { "config_set": { "key": "nope" }, "mappings": {} }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 2, "result": { "outcome": "refused", "message": "no configuration set 'nope'", "exit_code": 1 } } },
        { "send": { "kind": "call", "req_id": 3, "object": "/projects", "iface": "loomworks.ConfigSets", "v": 1, "method": "add", "args": { "name": "x", "mappings": { "ghost": "Debug" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 3, "result": { "outcome": "refused", "message": "no project 'ghost'", "exit_code": 1 } } },
        { "send": { "kind": "call", "req_id": 4, "object": "/projects", "iface": "loomworks.ConfigSets", "v": 1, "method": "add", "args": { "name": "x", "mappings": { "app": "Nope" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 4, "result": { "outcome": "refused", "message": "no configuration 'Nope' in project 'app'", "exit_code": 1 } } },
        { "send": { "kind": "call", "req_id": 5, "object": "/projects", "iface": "loomworks.ConfigSets", "v": 1, "method": "add", "args": { "name": "x" }, "env": { "$var": "env" } } },
        { "expect": { "kind": "error", "req_id": 5, "error": { "code": "invalid_args" } } }
      ]
    }
  ]
}
