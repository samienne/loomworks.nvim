{
  "transcripts": 1,
  "interface": "loomworks.Toolchains",
  "version": 1,
  "description": "Object /toolchains (spec 19.14, 19.20): list, in the client's environment.",
  "cases": [
    {
      "name": "list returns the detected toolchains per module type",
      "fixture": "shell",
      "allow": [ { "kind": "model_change" } ],
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/toolchains", "iface": "loomworks.Toolchains", "v": 1, "method": "list", "args": {}, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 1, "result": { "outcome": "ok", "tools": { "$type": "object" } } } },
        { "send": { "kind": "call", "req_id": 2, "object": "/toolchains", "iface": "loomworks.Toolchains", "v": 1, "method": "list", "args": {} } },
        { "expect": { "kind": "error", "req_id": 2, "error": { "code": "invalid_args" } } },
        { "send": { "kind": "call", "req_id": 3, "object": "/toolchains", "iface": "loomworks.Toolchains", "v": 1, "method": "list", "args": { "module": "cmake" }, "env": { "$var": "env" } } },
        { "expect": { "kind": "error", "req_id": 3, "error": { "code": "invalid_args" } } }
      ]
    }
  ]
}
