{
  "transcripts": 1,
  "interface": "loomworks.Projects",
  "version": 1,
  "description": "Object /projects (API.md §19; step 5o part B3): the declaration read with ids, a launch rename that keeps its id, a configuration rename under the same id, the environment reads, and the refusals of references and arguments.",
  "cases": [
    {
      "name": "declaration names each launch configuration by id; launch_save renames one, its id kept; another project's launch id is refused",
      "fixture": "shell",
      "allow": [
        {
          "kind": "model_change"
        },
        {
          "kind": "signal",
          "object": "/workspace",
          "name": "changed"
        }
      ],
      "steps": [
        {
          "send": {
            "kind": "call",
            "req_id": 1,
            "object": "/internal",
            "iface": "lw.internal.Snapshot",
            "v": 1,
            "method": "get",
            "args": {
              "scope": "config"
            },
            "env": {
              "$var": "env"
            }
          }
        },
        {
          "expect": {
            "kind": "ok",
            "req_id": 1,
            "result": {
              "index": {
                "projects": {
                  "app": {
                    "$bind": "app_id"
                  },
                  "lib": {
                    "$bind": "lib_id"
                  }
                }
              }
            }
          }
        },
        {
          "send": {
            "kind": "call",
            "req_id": 2,
            "object": "/projects",
            "iface": "loomworks.Projects",
            "v": 1,
            "method": "declaration",
            "args": {
              "project": {
                "id": {
                  "$var": "app_id"
                }
              }
            },
            "env": {
              "$var": "env"
            }
          }
        },
        {
          "expect": {
            "kind": "ok",
            "req_id": 2,
            "result": {
              "outcome": "ok",
              "launches": {
                "$contains": [
                  {
                    "id": {
                      "$bind": "hello_id"
                    },
                    "key": "hello",
                    "fields": {
                      "args": [
                        "--version"
                      ]
                    }
                  }
                ]
              },
              "configurations": {
                "$contains": [
                  {
                    "id": {
                      "$type": "string"
                    },
                    "key": "Debug"
                  }
                ]
              },
              "type_config": {
                "fields": {
                  "$type": "array"
                }
              }
            }
          }
        },
        {
          "send": {
            "kind": "call",
            "req_id": 3,
            "object": "/projects",
            "iface": "loomworks.Projects",
            "v": 1,
            "method": "launch_save",
            "args": {
              "project": {
                "key": "app"
              },
              "launch": {
                "id": {
                  "$var": "hello_id"
                }
              },
              "name": "hi",
              "data": {
                "command": "hi-tool"
              }
            },
            "env": {
              "$var": "env"
            }
          }
        },
        {
          "expect": {
            "kind": "ok",
            "req_id": 3,
            "result": {
              "outcome": "ok",
              "launch": {
                "$exact": {
                  "id": {
                    "$var": "hello_id"
                  },
                  "key": "hi"
                }
              }
            }
          }
        },
        {
          "send": {
            "kind": "call",
            "req_id": 4,
            "object": "/projects",
            "iface": "loomworks.Projects",
            "v": 1,
            "method": "launch_remove",
            "args": {
              "project": {
                "id": {
                  "$var": "lib_id"
                }
              },
              "launch": {
                "id": {
                  "$var": "hello_id"
                }
              }
            },
            "env": {
              "$var": "env"
            }
          }
        },
        {
          "expect": {
            "kind": "ok",
            "req_id": 4,
            "result": {
              "outcome": "refused",
              "exit_code": 1,
              "message": "launch configuration 'app:hi' is not of project 'lib'"
            }
          }
        },
        {
          "send": {
            "kind": "call",
            "req_id": 5,
            "object": "/projects",
            "iface": "loomworks.Projects",
            "v": 1,
            "method": "launch_remove",
            "args": {
              "project": {
                "key": "app"
              },
              "launch": {
                "key": "hi"
              }
            },
            "env": {
              "$var": "env"
            }
          }
        },
        {
          "expect": {
            "kind": "ok",
            "req_id": 5,
            "result": {
              "outcome": "ok"
            }
          }
        }
      ]
    },
    {
