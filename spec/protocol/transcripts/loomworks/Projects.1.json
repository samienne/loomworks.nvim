              "$var": "env"
            }
          }
        },
        {
          "expect": {
            "kind": "error",
            "req_id": 4,
            "error": {
              "code": "invalid_args"
            }
          }
        },
        {
          "send": {
            "kind": "call",
            "req_id": 5,
