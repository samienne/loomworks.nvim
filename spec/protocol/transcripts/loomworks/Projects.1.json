            "kind": "call",
            "req_id": 1,
            "object": "/projects",
            "iface": "loomworks.Projects",
            "v": 1,
            "method": "options_save",
            "args": {
              "project": {
                "id": "999.999"
              },
              "options": {
                "A": "1"
              }
            },
            "env": {
              "$var": "env"
            }
          }
        },
        {
          "expect": {
            "kind": "ok",
            "req_id": 1,
            "result": {
              "outcome": "refused",
