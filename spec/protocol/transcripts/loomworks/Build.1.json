{
  "transcripts": 1,
  "interface": "loomworks.Build",
  "version": 1,
  "description": "Object /build (API.md §8): build, configure, clean and reset as task-streamed methods; a profile or configuration units as the scope, jobs, project-qualified targets; references by key and by id; the outcomes as domain results.",
  "cases": [
    {
      "name": "build is accepted; its start meta names the method and its done carries the task result",
      "fixture": "shell",
      "allow": [
        { "kind": "task" },
        { "kind": "model_change" }
      ],
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "profile": { "key": "dev" }, "command": "lw build" }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 1, "result": { "outcome": "accepted", "task_id": { "$bind": "task", "$type": "string" }, "profile_key": "dev", "pid": { "$var": "welcome.header.pid" } } } },
        { "expect": {
            "kind": "task", "task_id": { "$var": "task" }, "phase": "start",
            "meta": { "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "kind": "build", "profile": "dev", "origin": "cli" }
        } },
        { "expect": { "kind": "task", "task_id": { "$var": "task" }, "phase": "done", "exit_code": 0, "result": { "$exact": { "exit_code": 0 } } }, "timeout_ms": 120000 }
      ]
    },
    {
      "name": "a profile named by its id from the snapshot index builds; clean then runs as a task",
      "fixture": "shell",
      "allow": [
        { "kind": "task" },
        { "kind": "model_change" }
      ],
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/internal", "iface": "lw.internal.Snapshot", "v": 1, "method": "get", "args": { "scope": "config" }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 1, "result": { "outcome": "ok", "index": { "profiles": { "dev": { "$bind": "dev_id", "$type": "string" } } } } } },
        { "send": { "kind": "call", "req_id": 2, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "profile": { "id": { "$var": "dev_id" } } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 2, "result": { "outcome": "accepted", "task_id": { "$bind": "build" }, "profile_key": "dev" } } },
        { "expect": { "kind": "task", "task_id": { "$var": "build" }, "phase": "done", "exit_code": 0, "result": { "exit_code": 0 } }, "timeout_ms": 120000 },
        { "send": { "kind": "call", "req_id": 3, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "clean", "args": { "profile": { "key": "dev" }, "command": "lw clean" }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 3, "result": { "outcome": "accepted", "task_id": { "$bind": "clean" }, "profile_key": "dev" } } },
        { "expect": { "kind": "task", "task_id": { "$var": "clean" }, "phase": "start", "meta": { "method": "clean", "kind": "clean" } } },
        { "expect": { "kind": "task", "task_id": { "$var": "clean" }, "phase": "done", "exit_code": 0, "result": { "exit_code": 0 } }, "timeout_ms": 60000 }
      ]
    },
    {
      "name": "the protocol-10 build alias keeps its v0 shape at protocol 10: integer task ids, flat outcome",
      "description": "An older client negotiates 10 and is served unchanged (PROTOCOL.md Annex A); its replies are checked against transport.json v0.replies.",
      "fixture": "shell",
      "hello": { "protocol": 10, "protocol_min": 10 },
      "allow": [ { "kind": "model_change" }, { "kind": "task", "phase": "line" }, { "kind": "task", "phase": "output" }, { "kind": "task", "phase": "progress" } ],
      "steps": [
        { "expect_none": { "kind": "signal" }, "within_ms": 100 },
        { "send": { "kind": "build", "req_id": 1, "args": { "profile": "dev" }, "interactive": false, "env": { "$var": "env" }, "command": "lw build" } },
        { "expect": { "kind": "ok", "req_id": 1, "outcome": "accepted", "task_id": { "$bind": "task", "$type": "integer" }, "profile_key": "dev" } },
        { "expect": { "kind": "task", "task_id": { "$var": "task" }, "phase": "start", "meta": { "kind": "build", "profile": "dev", "method": { "$absent": true } } } },
        { "expect": { "kind": "task", "task_id": { "$var": "task" }, "phase": "done", "exit_code": 0, "result": { "$absent": true } }, "timeout_ms": 120000 }
      ]
    },
    {
      "name": "an id of an earlier session generation is a stale reference: refused, never another entity",
      "description": "Ids carry the session generation (PROTOCOL.md §12.1). 1.1 stands for an id the first entity got in an earlier session (generation 1): before ids carried the generation, it would have named whatever entity this session numbered 1.",
      "fixture": "shell",
      "allow": [ { "kind": "model_change" } ],
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/internal", "iface": "lw.internal.Snapshot", "v": 1, "method": "get", "args": { "scope": "config" }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 1, "result": { "outcome": "ok", "index": { "profiles": { "dev": { "$type": "string" } } } } } },
        { "send": { "kind": "call", "req_id": 2, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "reset", "args": { "profile": { "id": "1.1" }, "yes": true }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 2, "result": { "outcome": "refused", "message": { "$pattern": "stale reference" }, "exit_code": 1 } } },
        { "send": { "kind": "call", "req_id": 3, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "profile": { "id": "1" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 3, "result": { "outcome": "refused", "message": { "$pattern": "stale reference" }, "exit_code": 1 } } }
      ]
    },
    {
      "name": "reset asks for confirmation with a plan token, runs once confirmed, then has nothing to reset",
      "fixture": "shell",
      "allow": [
        { "kind": "task" },
        { "kind": "model_change" }
      ],
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "profile": { "key": "dev" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 1, "result": { "outcome": "accepted", "task_id": { "$bind": "build" } } } },
        { "expect": { "kind": "task", "task_id": { "$var": "build" }, "phase": "done", "exit_code": 0 }, "timeout_ms": 120000 },
        { "send": { "kind": "call", "req_id": 2, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "reset", "args": { "profile": { "key": "dev" }, "command": "lw reset" }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 2, "result": { "outcome": "confirm", "lines": { "$type": "array" }, "plan": { "$bind": "plan", "$type": "string" }, "profile_key": "dev" } } },
        { "send": { "kind": "call", "req_id": 3, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "reset", "args": { "profile": { "key": "dev" }, "yes": true, "plan": { "$var": "plan" }, "command": "lw reset" }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 3, "result": { "outcome": "accepted", "task_id": { "$bind": "reset" } } } },
        { "expect": { "kind": "task", "task_id": { "$var": "reset" }, "phase": "start", "meta": { "method": "reset", "kind": "reset" } } },
        { "expect": { "kind": "task", "task_id": { "$var": "reset" }, "phase": "done", "exit_code": 0, "result": { "exit_code": 0 } }, "timeout_ms": 60000 },
        { "send": { "kind": "call", "req_id": 4, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "reset", "args": { "profile": { "key": "dev" }, "yes": true }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 4, "result": { "outcome": "refused", "message": { "$type": "string" }, "exit_code": 0, "stream": "out" } } }
      ]
    },
    {
      "name": "an unknown profile and a stale id are refused; malformed arguments are errors or declined",
      "fixture": "shell",
      "allow": [ { "kind": "model_change" } ],
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "profile": { "key": "nope" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 1, "result": { "outcome": "refused", "message": { "$type": "string" }, "exit_code": 1 } } },
        { "send": { "kind": "call", "req_id": 2, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "profile": { "id": "no-such-id" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 2, "result": { "outcome": "refused", "message": { "$pattern": "stale reference" }, "exit_code": 1 } } },
        { "send": { "kind": "call", "req_id": 3, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "targets": "app" }, "env": { "$var": "env" } } },
        { "expect": { "kind": "error", "req_id": 3, "error": { "code": "invalid_args" } } },
        { "send": { "kind": "call", "req_id": 4, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "profile": { "key": "dev", "id": "1" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "error", "req_id": 4, "error": { "code": "invalid_args" } } },
        { "send": { "kind": "call", "req_id": 5, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": {} } },
        { "expect": { "kind": "error", "req_id": 5, "error": { "code": "invalid_args" } } },
        { "send": { "kind": "call", "req_id": 6, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "reset", "args": { "all": true, "profile": { "key": "dev" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 6, "result": { "outcome": "declined", "reason": { "$type": "string" } } } }
      ]
    },
    {
      "name": "configure is accepted; its start meta names the method and kind configure; it ends with the task result",
      "fixture": "shell",
      "allow": [
        { "kind": "task" },
        { "kind": "model_change" }
      ],
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "configure", "args": { "profile": { "key": "dev" } }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 1, "result": { "outcome": "accepted", "task_id": { "$bind": "task", "$type": "string" }, "profile_key": "dev", "pid": { "$var": "welcome.header.pid" } } } },
        { "expect": {
            "kind": "task", "task_id": { "$var": "task" }, "phase": "start",
            "meta": { "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "configure", "kind": "configure", "profile": "dev",
              "units": [ { "project": "app", "configuration": "Debug" } ], "origin": "cli" }
        } },
        { "expect": { "kind": "task", "task_id": { "$var": "task" }, "phase": "done", "exit_code": 0, "result": { "$exact": { "exit_code": 0 } } }, "timeout_ms": 120000 }
      ]
    },
    {
      "name": "configuration units by id and by key: build (with jobs) and configure them; meta.profile and profile_key absent",
      "fixture": "shell",
      "allow": [
        { "kind": "task" },
        { "kind": "model_change" }
      ],
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/internal", "iface": "lw.internal.Snapshot", "v": 1, "method": "get", "args": { "scope": "config" }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 1, "result": { "outcome": "ok", "index": { "config_units": [ { "project": "app", "configuration": "Debug", "id": { "$bind": "unit_id", "$type": "string" } } ] } } } },
        { "send": { "kind": "call", "req_id": 2, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "units": [ { "id": { "$var": "unit_id" } } ], "jobs": 1 }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 2, "result": { "outcome": "accepted", "task_id": { "$bind": "build" }, "profile_key": { "$absent": true } } } },
        { "expect": {
            "kind": "task", "task_id": { "$var": "build" }, "phase": "start",
            "meta": { "method": "build", "kind": "build", "name": "app/Debug", "profile": { "$absent": true },
              "units": [ { "project": "app", "configuration": "Debug" } ] }
        } },
        { "expect": { "kind": "task", "task_id": { "$var": "build" }, "phase": "done", "exit_code": 0, "result": { "exit_code": 0 } }, "timeout_ms": 120000 },
        { "send": { "kind": "call", "req_id": 3, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "configure", "args": { "units": [ { "project": "app", "configuration": "Debug" } ], "reconfigure": true }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 3, "result": { "outcome": "accepted", "task_id": { "$bind": "configure" }, "profile_key": { "$absent": true } } } },
        { "expect": { "kind": "task", "task_id": { "$var": "configure" }, "phase": "start", "meta": { "method": "configure", "kind": "configure", "profile": { "$absent": true } } } },
        { "expect": { "kind": "task", "task_id": { "$var": "configure" }, "phase": "done", "exit_code": 0, "result": { "exit_code": 0 } }, "timeout_ms": 120000 }
      ]
    },
    {
      "name": "a { project, target } operand selects that project's target; a project the scope does not build ends the task",
      "description": "The shell module takes no build targets, so the qualified operand reaching app's build step ends the task with the in-process refusal; an operand naming a project outside the scope fails before any step.",
      "fixture": "shell",
      "allow": [
        { "kind": "task" },
        { "kind": "model_change" }
      ],
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "profile": { "key": "dev" }, "targets": [ { "project": "app", "target": "x" } ] }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 1, "result": { "outcome": "accepted", "task_id": { "$bind": "one" } } } },
        { "expect": { "kind": "task", "task_id": { "$var": "one" }, "phase": "done", "exit_code": 1, "result": { "exit_code": 1, "error": { "$pattern": "^app.*does not support \\-\\-target" } } }, "timeout_ms": 120000 },
        { "send": { "kind": "call", "req_id": 2, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "profile": { "key": "dev" }, "targets": [ "app", { "project": "nope", "target": "x" } ] }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 2, "result": { "outcome": "accepted", "task_id": { "$bind": "two" } } } },
        { "expect": { "kind": "task", "task_id": { "$var": "two" }, "phase": "done", "exit_code": 1, "result": { "exit_code": 1, "error": "target 'x' names project 'nope', which profile 'dev' does not build" } }, "timeout_ms": 120000 }
      ]
    },
    {
      "name": "units with a profile, an empty units list and jobs below 1 are invalid_args; an unknown unit and nothing to clean are refused",
      "fixture": "shell",
      "allow": [ { "kind": "model_change" } ],
      "steps": [
        { "send": { "kind": "call", "req_id": 1, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "profile": { "key": "dev" }, "units": [ { "project": "app", "configuration": "Debug" } ] }, "env": { "$var": "env" } } },
        { "expect": { "kind": "error", "req_id": 1, "error": { "code": "invalid_args" } } },
        { "send": { "kind": "call", "req_id": 2, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "configure", "args": { "units": [] }, "env": { "$var": "env" } } },
        { "expect": { "kind": "error", "req_id": 2, "error": { "code": "invalid_args" } } },
        { "send": { "kind": "call", "req_id": 3, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "jobs": 0 }, "env": { "$var": "env" } } },
        { "expect": { "kind": "error", "req_id": 3, "error": { "code": "invalid_args" } } },
        { "send": { "kind": "call", "req_id": 4, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "clean", "args": { "units": [ { "project": "app" } ] }, "env": { "$var": "env" } } },
        { "expect": { "kind": "error", "req_id": 4, "error": { "code": "invalid_args" } } },
        { "send": { "kind": "call", "req_id": 5, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "configure", "args": { "units": [ { "project": "app", "configuration": "Release" } ] }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 5, "result": { "outcome": "refused", "message": "no configuration unit app/Release (unknown project or configuration)", "exit_code": 1 } } },
        { "send": { "kind": "call", "req_id": 6, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "build", "args": { "units": [ { "id": "1.1" } ] }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 6, "result": { "outcome": "refused", "message": { "$pattern": "stale reference" }, "exit_code": 1 } } },
        { "send": { "kind": "call", "req_id": 7, "object": "/build", "iface": "loomworks.Build", "v": 1, "method": "clean", "args": { "units": [ { "project": "app", "configuration": "Debug" } ] }, "env": { "$var": "env" } } },
        { "expect": { "kind": "ok", "req_id": 7, "result": { "outcome": "refused", "message": "nothing to clean for app/Debug — no configured build directories.", "exit_code": 1 } } }
      ]
    }
  ]
}
