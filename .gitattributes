# Shell scripts must be LF on every platform — a CRLF `#!/usr/bin/env bash\r`
# or `\r`-terminated line breaks execution on Linux/macOS (and in CI).
*.sh text eol=lf

# Windows batch launchers must be CRLF — a LF-only .cmd breaks cmd.exe
# label/goto handling.
*.cmd text eol=crlf

# Vendored from loomworks (scripts/vendor.sh, VENDOR.MANIFEST): kept
# byte-identical on every platform, so no line-ending conversion.
VENDOR.MANIFEST -text
/spec/protocol/** -text
/lua/loomworks/proto/bytes.lua -text
/lua/loomworks/proto/envelope.lua -text
/lua/loomworks/proto/schema.lua -text
/lua/loomworks/proto/documents.lua -text
