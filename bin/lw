#!/bin/sh
# loomworks launcher `lw`.
#
# Stage: dev / nvim-hosted. Resolves the loomworks home (a checkout or an
# installed dist) and runs the CLI under headless Neovim. The standalone
# luvi + shim runtime slots into the marked RUNTIME section later without
# changing this interface (`lw build`, `lw profiles`, ...).
#
# Home resolution order:
#   1. $LOOMWORKS_HOME (set by the installer, or by you for a dev checkout)
#   2. the parent of this script's directory (works when bin/ is on PATH)
set -eu

if [ -n "${LOOMWORKS_HOME:-}" ]; then
  home=$LOOMWORKS_HOME
else
  home=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
fi

cli="$home/lua/loomworks/cli.lua"
if [ ! -f "$cli" ]; then
  echo "lw: cannot find the CLI at $cli" >&2
  echo "lw: set LOOMWORKS_HOME to your loomworks.nvim checkout or dist" >&2
  exit 1
fi

# --- RUNTIME (dev: headless Neovim; later: luvi + vim shim) -----------------
if ! command -v nvim >/dev/null 2>&1; then
  echo "lw: nvim not found on PATH (required by the current dev launcher)" >&2
  exit 1
fi
exec nvim --headless -u NONE -l "$cli" "$@"
